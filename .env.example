HOST=0.0.0.0
PORT=8787

# Upstream & Relay
CODEBUFF_API=
RELAY_URL=

# Rotating Proxy (Optional)
# File path relative to app root (default: proxies.txt)
PROXIES_FILE=proxies.txt
# Or direct proxy URLs, comma/newline separated (e.g. http://user:pass@host:port, socks5://host:port, host:port, host:port:user:pass)
PROXY_URL=

# Authentication & Security
API_KEY=freebuff-default-key
# Comma/newline separated tokens, or place .json/.jsonl in credentials/
FREEBUFF_TOKEN=
FREEBUFF_DEBUG=false

# Account Selection Strategy
# Options:
#   - sticky (default): Reuses the active session on one account until expired or rate-limited. Best for saving daily session quota.
#   - round_robin_active: Round-robins across all accounts that already have an active session. Balances traffic without burning extra sessions.
#   - pure_round_robin: Always round-robins every request across all available accounts, regardless of active sessions (warning: burns session quota faster).
ACCOUNT_SELECTION_STRATEGY=sticky
